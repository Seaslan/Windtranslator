                                    <TextBlock Text="{localization:LocalizedString Key=Sbce2377283c2455a}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="TranslateFileButton"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="TranslateFileButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Forward" />
                                    <TextBlock x:Name="TranslateFileButtonText" Text="{localization:LocalizedString Key=Sb7986efeed2532ee}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border
