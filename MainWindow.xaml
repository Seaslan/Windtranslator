<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Windtranslator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windtranslator">

    <Grid
        x:Name="WindowRoot"
        Background="Transparent"
        PointerPressed="WindowRoot_PointerPressed">
        <Border
            x:Name="AcrylicFallbackLayer"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <NavigationView
            x:Name="SidebarNavigationView"
            Background="Transparent"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            OpenPaneLength="200"
            CompactPaneLength="64"
            IsBackButtonVisible="Visible"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            BackRequested="SidebarNavigationView_BackRequested"
            Loaded="SidebarNavigationView_Loaded"
            SelectionChanged="SidebarNavigationView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem" Icon="Home" Content="主页" Tag="Home" />
                <NavigationViewItem x:Name="ImageNavigationItem" Icon="Pictures" Content="图片翻译" Tag="Image" />
                <NavigationViewItem x:Name="FileNavigationItem" Icon="Document" Content="文件翻译" Tag="File" />
                <NavigationViewItem x:Name="SettingsNavigationItem" Icon="Setting" Content="设置" Tag="Settings" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavigationItem" Icon="Help" Content="关于" Tag="About" />
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>

        <Grid Background="{ThemeResource WindPageBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Height="48"
                Background="Transparent">
                <Border
                    x:Name="TitleBarDragRegion"
                    Background="Transparent" />
                <TextBlock
                    x:Name="PageTitleTextBlock"
                    Text="Windtranslator"
                    Margin="16,0,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid
                x:Name="TranslationToolbar"
                Grid.Row="1"
                Padding="16,4,16,4"
                ColumnSpacing="8"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="ModeComboBox"
                    Grid.Column="0"
                    MinWidth="130"
                    Height="34"
                    VerticalAlignment="Center"
                    SelectionChanged="ModeComboBox_SelectionChanged" />

                <ComboBox
                    x:Name="SourceLanguageComboBox"
                    Grid.Column="1"
                    MinWidth="104"
                    Height="34"
                    VerticalAlignment="Center"
                    SelectionChanged="SourceLanguageComboBox_SelectionChanged" />

                <Button
                    x:Name="SwapLanguageButton"
                    Grid.Column="2"
                    Height="34"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Click="SwapLanguageButton_Click"
                    ToolTipService.ToolTip="交换语言">
                    <SymbolIcon Symbol="Switch" />
                </Button>

                <ComboBox
                    x:Name="TargetLanguageComboBox"
                    Grid.Column="3"
                    MinWidth="104"
                    Height="34"
                    VerticalAlignment="Center"
                    SelectionChanged="TargetLanguageComboBox_SelectionChanged" />

                <Button
                    x:Name="TranslateButton"
                    Grid.Column="4"
                    MinWidth="104"
                    Height="34"
                    Padding="16,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="TranslateButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Forward" />
                        <TextBlock x:Name="TranslateButtonText" Text="翻译" />
                    </StackPanel>
                </Button>

                <ProgressRing
                    x:Name="ProgressRing"
                    Grid.Column="5"
                    Width="22"
                    Height="22"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    IsActive="False" />
            </Grid>

            <Grid
                x:Name="HomePageGrid"
                Grid.Row="2"
                Margin="16,0,16,16"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="16,12,16,16"
                    Background="{ThemeResource WindCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WindCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="源文本"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center" />

                            <TextBlock
                                x:Name="SourceCountText"
                                Grid.Column="1"
                                Text="0 字"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button
                                x:Name="ClearSourceButton"
                                Grid.Column="2"
                                Padding="8,6"
                                Click="ClearSourceButton_Click"
                                ToolTipService.ToolTip="清空">
                                <SymbolIcon Symbol="Clear" />
                            </Button>

                            <Button
                                x:Name="MicButton"
                                Grid.Column="3"
                                Padding="8,6"
                                Click="MicButton_Click"
                                ToolTipService.ToolTip="语音输入">
                                <SymbolIcon x:Name="MicIcon" Symbol="Microphone" />
                            </Button>
                        </Grid>

                        <TextBox
                            x:Name="SourceTextBox"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            MinHeight="260"
                            AcceptsReturn="True"
                            FontFamily="Segoe UI"
                            FontSize="16"
                            PlaceholderText="输入或粘贴需要翻译的内容，也可以使用语音输入"
                            TextChanged="SourceTextBox_TextChanged"
                            TextWrapping="Wrap"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />

                        <Button
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Click="TranslationHistoryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Clock" />
                                <TextBlock Text="翻译历史" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16,12,16,16"
                    Background="{ThemeResource WindCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WindCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="译文"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center" />

                            <TextBlock
                                x:Name="OutputCountText"
                                Grid.Column="1"
                                Text="0 字"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button
                                x:Name="CopyButton"
                                Grid.Column="2"
                                Padding="8,6"
                                Click="CopyButton_Click"
                                ToolTipService.ToolTip="复制译文">
                                <SymbolIcon Symbol="Copy" />
                            </Button>

                            <Button
                                x:Name="SpeakButton"
                                Grid.Column="3"
                                Padding="8,6"
                                Click="SpeakButton_Click"
                                ToolTipService.ToolTip="朗读译文">
                                <SymbolIcon x:Name="SpeakIcon" Symbol="Audio" />
                            </Button>
                        </Grid>

                        <TextBox
                            x:Name="OutputTextBox"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            MinHeight="260"
                            AcceptsReturn="True"
                            FontFamily="Segoe UI"
                            FontSize="16"
                            IsReadOnly="True"
                            PlaceholderText="翻译结果会显示在这里"
                            TextChanged="OutputTextBox_TextChanged"
                            TextWrapping="Wrap"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>

            <Grid
                x:Name="TranslationHistoryPageGrid"
                Grid.Row="2"
                Margin="16,16,16,16"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="翻译历史"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="ClearTranslationHistoryButton"
                        Grid.Column="2"
                        Click="ClearTranslationHistoryButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Delete" />
                            <TextBlock Text="清除翻译历史" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <ListView
                        x:Name="TranslationHistoryListView"
                        IsItemClickEnabled="True"
                        ItemClick="TranslationHistoryListView_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border
                                                x:Name="HistoryItemBackground"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{ThemeResource WindCardBackgroundBrush}"
                                                BorderBrush="{ThemeResource WindCardStrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <ContentPresenter
                                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </Border>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="HistoryItemBackground.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="HistoryItemBackground.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="TranslationHistoryEmptyText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsHitTestVisible="False"
                        Text="暂无翻译历史" />
                </Grid>
            </Grid>

            <ScrollViewer
                x:Name="SettingsPageScrollViewer"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                SizeChanged="SettingsPageScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <ScrollViewer.Resources>
                    <Style x:Key="SettingsCardStyle" TargetType="Border">
                        <Setter Property="Background" Value="{ThemeResource WindCardBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource WindCardStrokeBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                    <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                    <Style x:Key="SettingsIconButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </ScrollViewer.Resources>
                <StackPanel
                    x:Name="SettingsCardsPanel"
                    Width="760"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    Padding="24,16,24,24"
                    Spacing="12">

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Header="API 翻译" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                        <TextBlock
                            Text="固定使用 TranslateECommerce 接口，密钥需手动输入。"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <TextBlock Text="AccessKey ID" />
                        <PasswordBox
                            x:Name="AliyunAccessKeyIdPasswordBox"
                            PasswordChanged="AliyunAccessKeyIdPasswordBox_PasswordChanged"
                            PlaceholderText="手动输入 AccessKey ID" />

                        <TextBlock Text="AccessKey Secret" />
                        <PasswordBox
                            x:Name="AliyunAccessKeySecretPasswordBox"
                            PasswordChanged="AliyunAccessKeySecretPasswordBox_PasswordChanged"
                            PlaceholderText="手动输入 AccessKey Secret" />

                        <CheckBox
                            x:Name="AliyunRememberKeyCheckBox"
                            Content="记住 AccessKey"
                            Checked="AliyunRememberKeyCheckBox_Changed"
                            Unchecked="AliyunRememberKeyCheckBox_Changed" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Header="AI 翻译" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                        <TextBlock
                            Text="调用云端大模型翻译，可自定义补充提示词。"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <ComboBox
                            x:Name="AiProviderComboBox"
                            MinWidth="220"
                            SelectionChanged="AiProviderComboBox_SelectionChanged" />

                        <TextBlock Text="接口地址" />
                        <TextBox
                            x:Name="AiEndpointTextBox"
                            PlaceholderText="https://api.deepseek.com"
                            TextChanged="AiEndpointTextBox_TextChanged" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="模型"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button
                                Grid.Column="1"
                                Click="AddAiModelButton_Click"
                                Style="{StaticResource SettingsIconButtonStyle}"
                                ToolTipService.ToolTip="添加模型">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </Button>
                        </Grid>

                        <ListView
                            x:Name="AiModelsListView"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionChanged="AiModelsListView_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        MinHeight="40"
                                        Padding="4"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <Button
                                                Click="EditAiModelApiKeyButton_Click"
                                                Style="{StaticResource SettingsIconButtonStyle}"
                                                ToolTipService.ToolTip="修改 API Key">
                                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                            </Button>
                                            <Button
                                                Click="DeleteAiModelButton_Click"
                                                Style="{StaticResource SettingsIconButtonStyle}"
                                                ToolTipService.ToolTip="删除模型">
                                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <CheckBox
                            x:Name="AiRememberKeyCheckBox"
                            Content="记住 API Key"
                            Checked="AiRememberKeyCheckBox_Changed"
                            Unchecked="AiRememberKeyCheckBox_Changed" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Header="图片翻译" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                                <ComboBox
                                    x:Name="ImageProviderComboBox"
                                    Header="服务商"
                                    MinWidth="220"
                                    SelectionChanged="ImageProviderComboBox_SelectionChanged" />
                                <TextBox
                                    x:Name="ImageEndpointTextBox"
                                    Header="接口地址"
                                    PlaceholderText="https://api.example.com"
                                    TextChanged="ImageEndpointTextBox_TextChanged" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="模型"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Button
                                        Grid.Column="1"
                                        Click="AddImageModelButton_Click"
                                        Style="{StaticResource SettingsIconButtonStyle}"
                                        ToolTipService.ToolTip="添加图片模型">
                                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    </Button>
                                </Grid>

                                <ListView
                                    x:Name="ImageModelsListView"
                                    HorizontalContentAlignment="Stretch"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionChanged="ImageModelsListView_SelectionChanged"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                MinHeight="40"
                                                Padding="4"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <Button
                                                        Click="EditImageModelApiKeyButton_Click"
                                                        Style="{StaticResource SettingsIconButtonStyle}"
                                                        ToolTipService.ToolTip="修改 API Key">
                                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                                    </Button>
                                                    <Button
                                                        Click="DeleteImageModelButton_Click"
                                                        Style="{StaticResource SettingsIconButtonStyle}"
                                                        ToolTipService.ToolTip="删除图片模型">
                                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <CheckBox
                                    x:Name="ImageRememberKeyCheckBox"
                                    Content="记住 API Key"
                                    Checked="ImageRememberKeyCheckBox_Changed"
                                    Unchecked="ImageRememberKeyCheckBox_Changed" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Header="本地翻译" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                        <ComboBox
                            x:Name="LocalTranslationSourceComboBox"
                            SelectionChanged="LocalTranslationSourceComboBox_SelectionChanged" />

                        <StackPanel x:Name="LocalEndpointPanel" Spacing="8">
                            <TextBlock Text="接口地址" />
                            <TextBox
                                x:Name="LocalEndpointTextBox"
                                PlaceholderText="http://localhost:11434/v1"
                                TextChanged="LocalEndpointTextBox_TextChanged" />

                            <TextBlock Text="模型" />
                            <TextBox
                                x:Name="LocalModelTextBox"
                                PlaceholderText="例如 qwen2.5:7b"
                                TextChanged="LocalModelTextBox_TextChanged" />

                            <Button
                                x:Name="RefreshLocalModelsButton"
                                Content="刷新本地模型"
                                Click="RefreshLocalModelsButton_Click" />
                        </StackPanel>

                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Style="{StaticResource SettingsExpanderStyle}">
                            <Expander.Header>
                                <TextBlock x:Name="OfflineModelsHeaderTextBlock" Text="离线语言模型（已下载 0 个）" />
                            </Expander.Header>
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="RefreshOfflineModelsButton"
                                Content="获取可下载模型"
                                Click="RefreshOfflineModelsButton_Click" />
                            <TextBlock
                                x:Name="OfflineModelsStatusTextBlock"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <ListView
                            x:Name="OfflineModelsListView"
                            MaxWidth="640"
                            HorizontalAlignment="Left"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding Details}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="64"
                                            Content="{Binding PrimaryActionText}"
                                            IsEnabled="{Binding CanDownload}"
                                            Click="OfflineModelPrimaryButton_Click" />
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="64"
                                            Content="删除"
                                            IsEnabled="{Binding IsInstalled}"
                                            Click="DeleteOfflineModelButton_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Header="外观" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                        <ComboBox
                            x:Name="ThemeComboBox"
                            MinWidth="180"
                            SelectionChanged="ThemeComboBox_SelectionChanged" />
                        <CheckBox
                            x:Name="MicaBackdropCheckBox"
                            Content="启用 Mica / Acrylic 材质"
                            Checked="MicaBackdropCheckBox_Changed"
                            Unchecked="MicaBackdropCheckBox_Changed" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Header="翻译历史" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                        <ComboBox
                            x:Name="TranslationHistoryLimitComboBox"
                            MinWidth="180"
                            SelectionChanged="TranslationHistoryLimitComboBox_SelectionChanged" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Header="AI 提示词" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                        <TextBlock Text="提示词风格" />
                        <ComboBox
                            x:Name="AiPromptStyleComboBox"
                            MinWidth="180"
                            SelectionChanged="AiPromptStyleComboBox_SelectionChanged" />
                        <CheckBox
                            x:Name="AiIncludeLanguageDetailsCheckBox"
                            Content="提供解释、读音和词性"
                            Checked="AiIncludeLanguageDetailsCheckBox_Changed"
                            Unchecked="AiIncludeLanguageDetailsCheckBox_Changed" />
                        <TextBlock Text="补充提示词" />
                        <TextBox
                            x:Name="CustomPromptTextBox"
                            MinHeight="96"
                            AcceptsReturn="True"
                            PlaceholderText="例如：保持术语一致，正式语气，不要加注释"
                            TextChanged="CustomPromptTextBox_TextChanged"
                            TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="ImagePageGrid"
                Grid.Row="2"
                Margin="16,8,16,16"
                ColumnSpacing="16"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="16"
                    Background="{ThemeResource WindCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WindCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="16">
                        <ComboBox
                            x:Name="ImageModelComboBox"
                            Header="模型"
                            SelectionChanged="ImageModelComboBox_SelectionChanged" />

                        <Button
                            x:Name="PickImageButton"
                            HorizontalAlignment="Left"
                            Click="PickImageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="添加图片" />
                            </StackPanel>
                        </Button>

                        <Grid Height="184">
                            <Border
                                Background="{ThemeResource WindLayerBackgroundBrush}"
                                BorderBrush="{ThemeResource WindCardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Image
                                        x:Name="ImagePreview"
                                        Margin="8"
                                        Stretch="Uniform"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="ImagePreviewPlaceholderText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="尚未选择图片" />
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="ImageSelectionSummaryText"
                                Text="未选择图片"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ListView
                                x:Name="SelectedImagesListView"
                                MaxHeight="112"
                                IsHitTestVisible="False"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="ImageSourceLanguageComboBox"
                                Header="源语言"
                                DisplayMemberPath="Display"
                                SelectionChanged="ImageSourceLanguageComboBox_SelectionChanged" />
                            <ComboBox
                                x:Name="ImageTargetLanguageComboBox"
                                Grid.Column="1"
                                Header="目标语言"
                                DisplayMemberPath="Display"
                                SelectionChanged="ImageTargetLanguageComboBox_SelectionChanged" />
                        </Grid>

                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="ClearImageSelectionButton"
                                Grid.Column="1"
                                IsEnabled="False"
                                Click="ClearImageSelectionButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="清除" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="TranslateImageButton"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="False"
                                Click="TranslateImageButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Forward" />
                                    <TextBlock Text="开始翻译" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource WindCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WindCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="译文" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="ImageTranslationProgressText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBox
                            x:Name="ImageOutputTextBox"
                            Grid.Row="1"
                            Margin="0,8,0,8"
                            MinHeight="260"
                            AcceptsReturn="True"
                            FontFamily="Segoe UI"
                            FontSize="16"
                            IsReadOnly="True"
                            PlaceholderText="翻译结果会按排序后的图片顺序显示在这里"
                            TextChanged="ImageOutputTextBox_TextChanged"
                            TextWrapping="Wrap"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />

                        <Button
                            x:Name="CopyImageOutputButton"
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Content="复制图片译文"
                            Click="CopyImageOutputButton_Click" />
                    </Grid>
                </Border>
            </Grid>

            <Grid
                x:Name="FilePageGrid"
                Grid.Row="2"
                Margin="16,8,16,16"
                ColumnSpacing="16"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="16"
                    Background="{ThemeResource WindCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WindCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="14">
                        <Button
                            x:Name="PickTextFileButton"
                            HorizontalAlignment="Left"
                            Click="PickTextFileButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="选择 .txt 文件" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            x:Name="SelectedTextFilePathText"
                            Text="尚未选择文件"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SelectedTextFileSizeText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="FileSourceLanguageComboBox"
                                Header="源语言"
                                DisplayMemberPath="Display"
                                SelectionChanged="FileSourceLanguageComboBox_SelectionChanged" />
                            <ComboBox
                                x:Name="FileTargetLanguageComboBox"
                                Grid.Column="1"
                                Header="目标语言"
                                DisplayMemberPath="Display"
                                SelectionChanged="FileTargetLanguageComboBox_SelectionChanged" />
                        </Grid>

                        <ComboBox
                            x:Name="FileModeComboBox"
                            Header="翻译模式"
                            SelectionChanged="FileModeComboBox_SelectionChanged" />
                        <TextBlock
                            x:Name="FileModeHintText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing
                                    x:Name="FileProgressRing"
                                    Width="22"
                                    Height="22"
                                    IsActive="False" />
                                <TextBlock
                                    x:Name="FileProgressText"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                x:Name="ClearTextFileButton"
                                Grid.Column="1"
                                IsEnabled="False"
                                Click="ClearTextFileButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="清除" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="TranslateFileButton"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="TranslateFileButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Forward" />
                                    <TextBlock x:Name="TranslateFileButtonText" Text="开始翻译" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource WindCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WindCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="译文" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBox
                            x:Name="FileOutputTextBox"
                            Grid.Row="1"
                            Margin="0,8,0,8"
                            MinHeight="340"
                            AcceptsReturn="True"
                            FontFamily="Segoe UI"
                            FontSize="16"
                            IsReadOnly="True"
                            PlaceholderText="翻译结果会显示在这里"
                            TextWrapping="Wrap"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button
                                x:Name="CopyFileOutputButton"
                                Content="复制"
                                IsEnabled="False"
                                Click="CopyFileOutputButton_Click" />
                            <Button
                                x:Name="ExportFileOutputButton"
                                Content="导出"
                                IsEnabled="False"
                                Click="ExportFileOutputButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel
                x:Name="AboutPagePanel"
                Grid.Row="2"
                Width="420"
                MaxWidth="420"
                Margin="24,16,24,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <Border
                    Padding="24"
                    Background="{ThemeResource WindCardBackgroundBrush}"
                    BorderBrush="{ThemeResource WindCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="16">
                            <Image
                                Width="64"
                                Height="64"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />

                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    Text="Windtranslator"
                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    x:Name="AboutVersionTextBlock"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            Text="简洁、快速的桌面翻译工具。"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="16"
                        VerticalAlignment="Top"
                        Background="{ThemeResource WindCardBackgroundBrush}"
                        BorderBrush="{ThemeResource WindCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="开发者" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    NavigateUri="https://github.com/seaslan">
                                    Seaslan
                                </HyperlinkButton>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="相关链接" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    NavigateUri="https://github.com/Seaslan/Windtranslator">
                                    项目主页
                                </HyperlinkButton>
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    NavigateUri="https://seaslan.github.io/Windtranslator/privacy">
                                    隐私政策
                                </HyperlinkButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Background="{ThemeResource WindCardBackgroundBrush}"
                        BorderBrush="{ThemeResource WindCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Expander
                            Header="使用的开源软件"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="False">
                            <StackPanel Padding="12,0,12,12" Spacing="4">
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    FontSize="12"
                                    NavigateUri="https://aka.ms/net">.NET 8</HyperlinkButton>
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    FontSize="12"
                                    NavigateUri="https://aka.ms/windowsappsdk">Windows App SDK</HyperlinkButton>
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    FontSize="12"
                                    NavigateUri="https://aka.ms/winui3">WinUI 3</HyperlinkButton>
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    FontSize="12"
                                    NavigateUri="https://github.com/mozilla/translations">Mozilla Translations</HyperlinkButton>
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    FontSize="12"
                                    NavigateUri="https://github.com/browsermt/bergamot-translator">Bergamot Translator</HyperlinkButton>
                            </StackPanel>
                        </Expander>
                    </Border>
                </Grid>

                <TextBlock
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="本软件的生成借助了 AI。" />
            </StackPanel>

            <InfoBar
                x:Name="StatusInfoBar"
                Grid.Row="3"
                Margin="16,0,16,16"
                CornerRadius="8"
                IsOpen="False"
                Severity="Informational" />
        </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
