<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Windtranslator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:localization="using:Windtranslator.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{localization:LocalizedString Key=Sd608ccd939a78fb2}">

    <Grid
        x:Name="WindowRoot"
        Background="Transparent"
        PointerPressed="WindowRoot_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <localization:LocalizedProviderConverter x:Key="LocalizedProviderConverter" />
            <DataTemplate x:Key="ProviderTemplate">
                <TextBlock Text="{Binding Converter={StaticResource LocalizedProviderConverter}}" />
            </DataTemplate>
            <DataTemplate x:Key="ProviderModelSelectionTemplate">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
        </Grid.Resources>
        <Border
            x:Name="AcrylicFallbackLayer"
            Grid.RowSpan="2"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <NavigationView
            x:Name="SidebarNavigationView"
            Background="Transparent"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="900"
            IsPaneOpen="True"
            CompactPaneLength="48"
            OpenPaneLength="200"
            IsBackButtonVisible="Visible"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            BackRequested="SidebarNavigationView_BackRequested"
            SelectionChanged="SidebarNavigationView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem" Icon="Home" Content="{localization:LocalizedString Key=S3e0d676d2d85073d}" Tag="Home" />
                <NavigationViewItem x:Name="ImageNavigationItem" Icon="Pictures" Content="{localization:LocalizedString Key=S0c84c73f4b24b3b8}" Tag="Image" />
                <NavigationViewItem x:Name="FileNavigationItem" Icon="Document" Content="{localization:LocalizedString Key=S822ba2796e8de87e}" Tag="File" />
                <NavigationViewItem x:Name="SettingsNavigationItem" Content="{localization:LocalizedString Key=Sdf3d58c7d84b85f2}" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <AnimatedIcon>
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE713;" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavigationItem" Icon="Help" Content="{localization:LocalizedString Key=S52d25a9e30ba94f1}" Tag="About" />
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>

        <Grid Background="{ThemeResource WindPageBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Height="48"
                Background="Transparent">
                <Border
                    x:Name="TitleBarDragRegion"
                    Background="Transparent" />
                <TextBlock
                    x:Name="PageTitleTextBlock"
                    Text="{localization:LocalizedString Key=Sd608ccd939a78fb2}"
                    Margin="16,0,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>

            <ContentControl x:Name="HomeToolbarHost" Grid.Row="1"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl x:Name="HomePageHost" Grid.Row="2"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <ContentControl
                x:Name="TranslationHistoryPageHost"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />

            <ContentControl
                x:Name="FavoritesPageHost"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />

            <ContentControl x:Name="SettingsPageHost" Grid.Row="2" Visibility="Collapsed"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ScrollViewer
                x:Name="SettingsPageScrollViewer"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <ScrollViewer.Resources>
                    <Style x:Key="SettingsCardStyle" TargetType="Border">
                        <Setter Property="Background" Value="{ThemeResource WindCardBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource WindCardStrokeBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                    <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
                        <Setter Property="IsExpanded" Value="False" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                    <Style x:Key="SettingsHeaderTitleStyle" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="TextAlignment" Value="Left" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="SettingsHeaderDescriptionStyle" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="TextAlignment" Value="Left" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="SettingsHeaderGridStyle" TargetType="Grid">
                        <Setter Property="MinHeight" Value="64" />
                        <Setter Property="Padding" Value="4,6,8,6" />
                        <Setter Property="ColumnSpacing" Value="12" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                    <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
                        <Setter Property="Margin" Value="4,4,4,0" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="SettingsIconButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </ScrollViewer.Resources>
                <StackPanel
                    x:Name="SettingsCardsPanel"
                    Spacing="12">

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Style="{StaticResource SettingsExpanderStyle}">
                            <Expander.Header>
                                <Grid Style="{StaticResource SettingsHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Symbol="Pictures" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{localization:LocalizedString Key=S0c84c73f4b24b3b8}" Style="{StaticResource SettingsHeaderTitleStyle}" />
                                        <TextBlock Text="{localization:LocalizedString Key=S38c87877f29cf060}" Style="{StaticResource SettingsHeaderDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                                <ComboBox
                                    x:Name="ImageProviderComboBox"
                                    ItemTemplate="{StaticResource ProviderTemplate}"
                                    Header="{localization:LocalizedString Key=S033ed59452549c51}"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="ImageProviderComboBox_SelectionChanged" />
                                <TextBlock Text="{localization:LocalizedString Key=Sc98e118e0a43f078}" />
                                <ListView
                                    x:Name="ImageModelsListView"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionChanged="ImageModelsListView_SelectionChanged"
                                    SelectionMode="Single" />
                                <TextBlock
                                    Text="{localization:LocalizedString Key=Se0d99ccba87fe53e}"
                                    Style="{StaticResource SettingsHeaderDescriptionStyle}" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Style="{StaticResource SettingsExpanderStyle}">
                            <Expander.Header>
                                <Grid Style="{StaticResource SettingsHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Symbol="Remote" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{localization:LocalizedString Key=S8f4e49aeafbade43}" Style="{StaticResource SettingsHeaderTitleStyle}" />
                                        <TextBlock Text="{localization:LocalizedString Key=S7244c05cb62fc39c}" Style="{StaticResource SettingsHeaderDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                        <ComboBox
                            x:Name="LocalTranslationSourceComboBox"
                            SelectionChanged="LocalTranslationSourceComboBox_SelectionChanged" />

                        <StackPanel x:Name="LocalEndpointPanel" Spacing="8">
                            <TextBlock Text="{localization:LocalizedString Key=S03b11112dc970014}" />
                            <TextBox
                                x:Name="LocalEndpointTextBox"
                                PlaceholderText="http://localhost:11434/v1"
                                TextChanged="LocalEndpointTextBox_TextChanged" />

                            <TextBlock Text="{localization:LocalizedString Key=Sc98e118e0a43f078}" />
                            <TextBox
                                x:Name="LocalModelTextBox"
                                PlaceholderText="{localization:LocalizedString Key=S177c17dc8aa34a2b}"
                                TextChanged="LocalModelTextBox_TextChanged" />

                            <Button
                                x:Name="RefreshLocalModelsButton"
                                Content="{localization:LocalizedString Key=S10bf64e5aab41b1b}"
                                Click="RefreshLocalModelsButton_Click" />
                        </StackPanel>

                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Expander Style="{StaticResource SettingsExpanderStyle}">
                            <Expander.Header>
                                <Grid Style="{StaticResource SettingsHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Symbol="Download" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            x:Name="OfflineModelsHeaderTextBlock"
                                            Text="{localization:LocalizedString Key=Sb385619812be9a22}"
                                            Style="{StaticResource SettingsHeaderTitleStyle}" />
                                        <TextBlock Text="{localization:LocalizedString Key=Sce3334d85570c680}" Style="{StaticResource SettingsHeaderDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Padding="16,0,16,16" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="RefreshOfflineModelsButton"
                                Content="{localization:LocalizedString Key=S6338f8924dee7084}"
                                Click="RefreshOfflineModelsButton_Click" />
                            <TextBlock
                                x:Name="OfflineModelsStatusTextBlock"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <ListView
                            x:Name="OfflineModelsListView"
                            MaxWidth="640"
                            HorizontalAlignment="Left"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding Details}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="64"
                                            Content="{Binding PrimaryActionText}"
                                            IsEnabled="{Binding CanDownload}"
                                            Click="OfflineModelPrimaryButton_Click" />
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="64"
                                            Content="{localization:LocalizedString Key=S2f9daa828907b93f}"
                                            IsEnabled="{Binding IsInstalled}"
                                            Click="DeleteOfflineModelButton_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                            </StackPanel>
                        </Expander>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <ContentControl x:Name="ImagePageHost" Grid.Row="2" Visibility="Collapsed"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <ContentControl
                x:Name="FilePageHost"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />

            <ContentControl
                x:Name="AboutPageHost"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />

        </Grid>
            </NavigationView.Content>
        </NavigationView>

        <!-- Mini mode fills the window independently of NavigationView's pane layout. -->
        <Grid x:Name="MiniWindowGrid" Background="{ThemeResource WindPageBackgroundBrush}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="Transparent">
                <Border x:Name="MiniTitleBarDragRegion" Background="Transparent" />
                <TextBlock
                    Text="{localization:LocalizedString Key=Sd608ccd939a78fb2}"
                    Margin="16,0,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>
            <!-- Pilot: the mini translator body is rendered by Microsoft.UI.Reactor (MiniTranslator.cs). -->
            <ContentControl x:Name="MiniPageHost" Grid.Row="1" Padding="12"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="16,0,16,16"
            CornerRadius="8"
            IsOpen="False"
            Visibility="{x:Bind StatusInfoBar.IsOpen, Mode=OneWay}"
            Severity="Informational" />

        <ContentControl x:Name="ClipboardTipHost"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

    </Grid>
</Window>
