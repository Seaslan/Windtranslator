                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SelectedTextFileSizeText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="FileSourceLanguageComboBox"
