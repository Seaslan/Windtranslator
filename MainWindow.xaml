                            <ComboBoxItem Content="{localization:LocalizedString Key=S5239fbb2909810d6}" />
                            <ComboBoxItem Content="{localization:LocalizedString Key=S8f4e49aeafbade43}" />
                        </ComboBox>
                        <TextBlock
                            x:Name="FileModeHintText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing
                                    x:Name="FileProgressRing"
                                    Width="22"
                                    Height="22"
