<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Windtranslator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:localization="using:Windtranslator.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{localization:LocalizedString Key=Sd608ccd939a78fb2}">

    <Grid
        x:Name="WindowRoot"
        Background="Transparent"
        PointerPressed="WindowRoot_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <localization:LocalizedProviderConverter x:Key="LocalizedProviderConverter" />
            <DataTemplate x:Key="ProviderTemplate">
                <TextBlock Text="{Binding Converter={StaticResource LocalizedProviderConverter}}" />
            </DataTemplate>
            <DataTemplate x:Key="ProviderModelSelectionTemplate">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
        </Grid.Resources>
        <Border
            x:Name="AcrylicFallbackLayer"
            Grid.RowSpan="2"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <NavigationView
            x:Name="SidebarNavigationView"
            Background="Transparent"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="900"
            IsPaneOpen="True"
            CompactPaneLength="48"
            OpenPaneLength="200"
            IsBackButtonVisible="Visible"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            BackRequested="SidebarNavigationView_BackRequested"
            SelectionChanged="SidebarNavigationView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem" Icon="Home" Content="{localization:LocalizedString Key=S3e0d676d2d85073d}" Tag="Home" />
                <NavigationViewItem x:Name="ImageNavigationItem" Icon="Pictures" Content="{localization:LocalizedString Key=S0c84c73f4b24b3b8}" Tag="Image" />
                <NavigationViewItem x:Name="FileNavigationItem" Icon="Document" Content="{localization:LocalizedString Key=S822ba2796e8de87e}" Tag="File" />
                <NavigationViewItem x:Name="SettingsNavigationItem" Content="{localization:LocalizedString Key=Sdf3d58c7d84b85f2}" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <AnimatedIcon>
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE713;" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavigationItem" Icon="Help" Content="{localization:LocalizedString Key=S52d25a9e30ba94f1}" Tag="About" />
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>

        <Grid Background="{ThemeResource WindPageBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Height="48"
                Background="Transparent">
                <Border
                    x:Name="TitleBarDragRegion"
                    Background="Transparent" />
                <TextBlock
                    x:Name="PageTitleTextBlock"
                    Text="{localization:LocalizedString Key=Sd608ccd939a78fb2}"
                    Margin="16,0,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>

            <ContentControl x:Name="HomeToolbarHost" Grid.Row="1"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl x:Name="HomePageHost" Grid.Row="2"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <ContentControl
                x:Name="TranslationHistoryPageHost"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />

            <ContentControl
                x:Name="FavoritesPageHost"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />

            <ContentControl x:Name="SettingsPageHost" Grid.Row="2" Visibility="Collapsed"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <ContentControl x:Name="ImagePageHost" Grid.Row="2" Visibility="Collapsed"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <ContentControl
                x:Name="FilePageHost"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />

            <ContentControl
                x:Name="AboutPageHost"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />

        </Grid>
            </NavigationView.Content>
        </NavigationView>

        <!-- Mini mode fills the window independently of NavigationView's pane layout. -->
        <Grid x:Name="MiniWindowGrid" Background="{ThemeResource WindPageBackgroundBrush}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="Transparent">
                <Border x:Name="MiniTitleBarDragRegion" Background="Transparent" />
                <TextBlock
                    Text="{localization:LocalizedString Key=Sd608ccd939a78fb2}"
                    Margin="16,0,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>
            <!-- Pilot: the mini translator body is rendered by Microsoft.UI.Reactor (MiniTranslator.cs). -->
            <ContentControl x:Name="MiniPageHost" Grid.Row="1" Padding="12"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="16,0,16,16"
            CornerRadius="8"
            IsOpen="False"
            Visibility="{x:Bind StatusInfoBar.IsOpen, Mode=OneWay}"
            Severity="Informational" />

        <ContentControl x:Name="ClipboardTipHost"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

    </Grid>
</Window>
